<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ErgouIME</string>
	<!-- Required in practice: without an app icon, switching to this input
	     source in WeChat crashed WeChat inside TextInputUIMacHelper
	     (-[TUINSCursorUIController _selectCurrentInputSource], CFRelease(NULL)),
	     2026-11-09 on macOS 27.0.1. WeChat IME and Squirrel both set it. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleDisplayName</key>
	<string>二狗输入法</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 ergou-ime contributors. GPL-3.0.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- Background agent: no Dock icon, no menu bar of its own. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSBackgroundOnly</key>
	<false/>

	<!-- ===== InputMethodKit ===== -->
	<!-- Mach service name IMKServer listens on; must match main.swift. -->
	<key>InputMethodConnectionName</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)_Connection</string>
	<!-- Swift classes need the module prefix. -->
	<key>InputMethodServerControllerClass</key>
	<string>ErgouIME.ErgouInputController</string>
	<key>InputMethodServerDelegateClass</key>
	<string>ErgouIME.ErgouInputController</string>

	<!-- ===== Text Input Sources ===== -->
	<key>TISInputSourceID</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>TISIntendedLanguage</key>
	<string>zh-Hans</string>
	<key>tsInputMethodIconFileKey</key>
	<string>ergou.pdf</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hans</string>
		<string>Latn</string>
	</array>
	<key>TICapsLockLanguageSwitchCapable</key>
	<true/>
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>com.codamon.inputmethod.Ergou.Wubi</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>com.codamon.inputmethod.Ergou.Wubi</string>
				<key>TISIntendedLanguage</key>
				<string>zh-Hans</string>
				<key>tsInputModeScriptKey</key>
				<string>smUnicodeScript</string>
				<key>tsInputModeCharacterRepertoireKey</key>
				<array>
					<string>Hans</string>
					<string>Latn</string>
				</array>
				<key>tsInputModeMenuIconFileKey</key>
				<string>ergou.pdf</string>
				<key>tsInputModeAlternateMenuIconFileKey</key>
				<string>ergou.pdf</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>ergou.pdf</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeKeyEquivalentModifiersKey</key>
				<integer>4608</integer>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>com.codamon.inputmethod.Ergou.Wubi</string>
		</array>
	</dict>

	<!-- App Group shared with ErgouIME Settings (Shared/Paths.swift). -->
	<key>ErgouAppGroupID</key>
	<string>$(ERGOU_APP_GROUP_ID)</string>

	<!-- Push-to-talk (M2/M3). Audio stays in memory and is transcribed on-device. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>二狗输入法在你按住说话快捷键时录音，并只在本机把语音转成文字。录音不会保存，也不会上传。</string>
</dict>
</plist>
