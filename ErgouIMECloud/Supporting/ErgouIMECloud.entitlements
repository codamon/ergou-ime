<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ErgouIME Cloud entitlements: the cloud tidy-up (Shared/Privacy.swift rule 11).
  Sandboxed. network.client (outgoing HTTPS to the provider the user chose)
  and the App Group (shared settings, the API key file) — nothing else: no
  network.server, no audio, no files outside the group.
  scripts/check-no-network.sh checks exactly this set.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(ERGOU_APP_GROUP_ID)</string>
	</array>
</dict>
</plist>
