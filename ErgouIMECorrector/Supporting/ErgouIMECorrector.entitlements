<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ErgouIME Corrector entitlements. Sandboxed, NO network: it only reads
  models from the App Group container (checked against SHA-256 first) and
  turns text into corrected text. The cloud option will live elsewhere.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(ERGOU_APP_GROUP_ID)</string>
	</array>
</dict>
</plist>
